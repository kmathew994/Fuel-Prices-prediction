# Copy this file to .env and fill in your real NSW FuelCheck API credentials.
# Get credentials at https://api.nsw.gov.au (Fuel Check Portal API).
# publisher.py loads these automatically via python-dotenv.
FUELCHECK_API_KEY=your_api_key_here
FUELCHECK_API_SECRET=your_api_secret_here
FUELCHECK_AUTH_HEADER=Basic base64(client_id:client_secret)

# Public MQTT broker + topic bridging publisher.py and dashboard.py.
# Defaults already match between both scripts - only override if needed.
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC=kmathew994/fuelcheck/nsw/prices
